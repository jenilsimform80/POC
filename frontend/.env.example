# Copy to .env.local (git-ignored) to override. Defaults work with `npm run dev` + the backend on :3000.

# Where the Vite dev/preview server forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:3000

# Base URL the browser uses for API calls. Leave unset to use the same-origin path "/api"
# (works through the dev proxy and behind a reverse proxy in production).
# If you point it at another origin, the backend must list this app's origin in CORS_ORIGIN and
# the session cookie must be sent cross-site (SameSite) - not recommended.
# VITE_API_BASE_URL=/api
