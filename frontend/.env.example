# Copy to .env (git-ignored). Restart `npm run dev` after changing it.

# Base URL the browser uses for API calls (the backend, including the /api prefix).
# Browser origin (http://localhost:5173) must be listed in the backend's CORS_ORIGIN.
# Open the app on `localhost`, not 127.0.0.1, so the session cookie stays same-site with the API.
# Leave unset to use the same-origin path "/api" (Docker/nginx reverse proxy deployment).
VITE_API_URL=http://localhost:3000/api
