# Copy to `.env` (git-ignored) before `docker compose up`. Use long random alphanumeric passwords, e.g.
#   openssl rand -hex 24
# (they are embedded in connection URLs, so avoid characters that need URL-encoding).
# These example values are placeholders: compose refuses to start until you replace them.

# PostgreSQL superuser inside the container (used only to create the roles on first start).
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=timesheets
# Owns the schema; used only by the one-shot `migrate` service.
DB_OWNER_PASSWORD=CHANGE_ME
# Used by the running backend: data access only (cannot alter tables, disable triggers or TRUNCATE).
DB_APP_PASSWORD=CHANGE_ME

# The exact URL users type in the browser (scheme + host + port, no trailing slash). Must match the
# backend FRONTEND_URL. Production needs HTTPS in front (the session cookie is Secure).
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
SESSION_TTL_HOURS=8

# Only for `docker compose --profile demo run --rm seed` (demo data, 12+ characters). Leave unset otherwise.
# SEED_PASSWORD=
