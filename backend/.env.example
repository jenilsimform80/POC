# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
# NODE_ENV must be set explicitly; if it is missing the app behaves as PRODUCTION (fail-safe).
# Number of reverse-proxy hops to trust for the client IP (0 = none). Never "true".
TRUST_PROXY=0
# Absolute session lifetime (hours) and login throttling (per IP)
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_ATTEMPT_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173
# To use "Try it out" for write calls in Swagger UI (http://localhost:3000/api-docs), also allow the
# API's own origin, e.g. FRONTEND_URL=http://localhost:5173,http://localhost:3000 (then restart).

# Swagger UI (/api-docs) and the OpenAPI JSON (/api-docs.json). Unset = ON outside production,
# OFF in production. Set true/false to override.
# API_DOCS_ENABLED=true

# Local PostgreSQL. Create the role/databases first (see docs/database-design.md).
DATABASE_URL=postgresql://timesheets:CHANGE_ME@localhost:5432/timesheets_dev?schema=public
